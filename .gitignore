# ==============================================================================
# 1. ENVIRONMENT & SECRETS (Jangan pernah di-commit ke Git)
# ==============================================================================
.env
.env.*
*.env
*.env.local
*.env.*.local

# ==============================================================================
# 2. PYTHON / BACKEND
# ==============================================================================
# Python cache & compiled bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual Environment
backend/venv/
backend/.venv/
venv/
.venv/
env/
.env/
ENV/

# Database (SQLite / lokal database)
backend/absensi.db
*.db
*.sqlite3

# Catatan: Jika bobot model wajah (.onnx) terlalu besar untuk GitHub (>100MB), 
# buka tanda komentar (#) pada baris di bawah ini:
# backend/models_weights/

# ==============================================================================
# 3. NODE / FRONTEND (Vite)
# ==============================================================================
# Dependencies
node_modules/
frontend/node_modules/

# Production / Build output
dist/
dist-ssr/
frontend/dist/
frontend/dist-ssr/

# Vite cache
.vite/
frontend/.vite/

# ==============================================================================
# 4. LOGS & DIAGNOSTICS
# ==============================================================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==============================================================================
# 5. EDITOR & SYSTEM FILES
# ==============================================================================
# System files
.DS_Store
Thumbs.db

# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json

# JetBrains (PyCharm, WebStorm, dll)
.idea/

# Visual Studio & editor lainnya
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
